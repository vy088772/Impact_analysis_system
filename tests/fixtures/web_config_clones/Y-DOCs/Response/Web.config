<?xml version="1.0"?>
<!-- Trimmed copy of the Y-DOCs Response Web.config. Credentials are placeholders.
     "PUR" and "ErrLog" stay commented out: the tests assert that they never resolve. -->
<configuration>
  <appSettings>
    <add key="WebSite" value="TTPUR"/>
    <add key="MailServer" value="mail.example.test"/>
  </appSettings>
  <connectionStrings>
    <!--<add name="PUR" connectionString="Data Source=vmsystest07;Initial Catalog=PUR;User ID=u;Password=p" providerName="System.Data.SqlClient"/>-->
    <add name="PUR-FAQ" connectionString="Data Source=vmsystest07;Initial Catalog=Response;User ID=u;Password=p" providerName="System.Data.SqlClient"/>
    <!--<add name="ErrLog" connectionString="Data Source=vmsystest03;Initial Catalog=SysErrorRecord;User ID=u;Password=p" providerName="System.Data.SqlClient"/>-->
  </connectionStrings>
</configuration>
